<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
      No Bluetooth permission is declared. Media already routes to a paired
      headset through the platform audio stack, so the browser never needs to
      scan for or connect to a device itself.
    -->

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <application
        android:name=".LibreWolfApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LibreWolf">
        <meta-data
            android:name="android.app.shortcuts"
            android:resource="@xml/shortcuts" />
        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="stateUnspecified|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/html" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".PrivateBrowsingDismissReceiver"
            android:exported="false" />

        <receiver
            android:name=".MediaActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.palash.librewolfandroid.MEDIA_PLAY" />
                <action android:name="com.palash.librewolfandroid.MEDIA_PAUSE" />
                <action android:name="com.palash.librewolfandroid.MEDIA_STOP" />
            </intent-filter>
        </receiver>
        <service
            android:name=".BrowserMediaService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".GeckoCrashService"
            android:exported="false"
            android:process=":gecko_crash">
            <intent-filter>
                <action android:name="org.mozilla.gecko.ACTION_CRASHED" />
            </intent-filter>
        </service>

        <service
            android:name=".DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".SitePermissionsActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />
        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".BookmarksActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".DownloadsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".PasswordsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ExtensionsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />
        <activity
            android:name=".SearchEnginesActivity"
            android:exported="false"
            android:parentActivityName=".SearchActivity" />
        <activity
            android:name=".DefaultSearchActivity"
            android:exported="false"
            android:parentActivityName=".SearchActivity" />
        <activity
            android:name=".TabsSettingsActivity"
            android:exported="false"
            android:parentActivityName=".SettingsActivity" />
    </application>

</manifest>
