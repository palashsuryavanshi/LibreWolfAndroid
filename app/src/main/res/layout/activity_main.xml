<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/librewolf_bg"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/home_center"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.mozilla.geckoview.GeckoView
            android:id="@+id/geckoview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- The start page: logo at the top left, title at the top right, on one
             row and sharing its height. A Space pushes the title to the end, so
             the row itself stays one line; nesting the title in a second row put
             it below the logo instead of beside it. Both live inside
             home_overlay so they appear and disappear with it; as siblings of it
             the logo would sit on top of every loaded page. -->
        <LinearLayout
            android:id="@+id/home_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp">

            <!-- The logo is decorative: the title beside it already says the app name, so
             labelling this too made a screen reader announce it twice. -->
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/librewolf_logo" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
            android:id="@+id/home_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:text="@string/app_name"
            android:textColor="@color/librewolf_text"
            android:textSize="20sp"
            android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_pip"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:background="@drawable/bg_fab"
            android:contentDescription="@string/picture_in_picture"
            android:padding="12dp"
            android:src="@drawable/ic_pip"
            android:visibility="gone" />
    </FrameLayout>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="100"
        android:progressTint="@color/librewolf_accent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/suggestions_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/librewolf_bg"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- The suggestion list is bounded in code, not by android:maxHeight:
             that attribute is honoured by TextView and ImageView and silently
             ignored by RecyclerView. Left unbounded it grows with the result
             count and pushes browser_controls off the bottom of the screen,
             taking the address bar and the menu button with it and leaving no
             way out but the system gesture. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/suggestions_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/browser_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <!-- minHeight rather than height: the row holds the address text, which is
             the most-scaled text in the app, and a fixed height clipped it once
             the system font scale rose. The engine badge inside is sized off its
             own glyph so it cannot clip either. -->
        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_bar"
            android:gravity="center_vertical"
            android:minHeight="@dimen/toolbar_min_height"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:id="@+id/engine_picker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/touch_target"
                android:minWidth="@dimen/touch_target"
                android:orientation="horizontal"
                android:paddingEnd="4dp"
                android:paddingStart="4dp">

                <TextView
                    android:id="@+id/engine_badge"
                    android:layout_width="@dimen/engine_badge_min_size"
                    android:layout_height="@dimen/engine_badge_min_size"
                    android:background="@drawable/bg_engine_badge"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:minWidth="@dimen/engine_badge_min_size"
                    android:textColor="@color/librewolf_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/engine_chevron"
                    android:layout_width="16dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>

            <EditText
                android:id="@+id/address_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@null"
                android:ellipsize="middle"
                android:gravity="center_vertical"
                android:hint="@string/url_hint"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:minHeight="40dp"
                android:textColor="@color/librewolf_text"
                android:textColorHint="@color/librewolf_grey"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btn_voice"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/show_voice_search"
                android:focusable="true"
                android:src="@drawable/ic_mic"
                android:visibility="gone" />
        </LinearLayout>

        <!-- The count is the whole affordance, so it has to read as a button and
             be reachable by touch. 38x32dp was neither. -->
        <TextView
            android:id="@+id/tabs_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_tab_count"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="@dimen/touch_target"
            android:minHeight="@dimen/touch_target"
            android:textColor="@color/librewolf_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_menu"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu"
            android:focusable="true"
            android:src="@drawable/ic_menu" />
    </LinearLayout>
</LinearLayout>
