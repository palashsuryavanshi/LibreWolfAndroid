<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/librewolf_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageButton
            android:id="@+id/bookmarks_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bookmarks"
            android:textColor="@color/librewolf_text"
            android:textSize="24sp" />

        <ImageButton
            android:id="@+id/bookmarks_search"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_bookmarks"
            android:src="@drawable/ic_filter" />

        <ImageButton
            android:id="@+id/bookmarks_add"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/add_bookmark"
            android:src="@drawable/ic_folder_add" />
    </LinearLayout>

    <!-- The list and the empty state overlay each other in this frame, so exactly
         one of them is visible: with the list GONE the message takes the whole
         area, and with the list shown the message is GONE and the rows fill. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/bookmarks_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include
            android:id="@+id/bookmarks_empty"
            layout="@layout/view_empty_state" />

        <ImageButton
            android:id="@+id/bookmarks_fab"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:background="@drawable/bg_fab"
            android:contentDescription="@string/search_bookmarks"
            android:src="@drawable/ic_search" />
    </FrameLayout>
</LinearLayout>
