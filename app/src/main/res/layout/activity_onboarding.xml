<?xml version="1.0" encoding="utf-8"?>
<!--
    One layout, three pages of content swapped in by OnboardingActivity. The pages
    differ only in words, so separate layouts would be three copies of the same
    skeleton to keep in step.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/librewolf_bg"
    android:orientation="vertical">

    <!-- Nothing here is a link, so nothing gets an accessibility focus stop. -->
    <TextView
        android:id="@+id/onboarding_skip"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="end"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/onboarding_skip"
        android:textColor="@color/librewolf_grey"
        android:textSize="15sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/onboarding_art"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="28dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_globe" />

            <TextView
                android:id="@+id/onboarding_step"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:textColor="@color/librewolf_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/onboarding_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textColor="@color/librewolf_text"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/onboarding_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.25"
                android:textColor="@color/librewolf_grey"
                android:textSize="16sp" />

            <!-- Bullet list, only on the page that has one. -->
            <LinearLayout
                android:id="@+id/onboarding_bullets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/onboarding_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/librewolf_grey"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Optional, only shown when the system actually offers the role. -->
            <LinearLayout
                android:id="@+id/onboarding_default_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@color/librewolf_card"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:padding="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/onboarding_default_browser"
                        android:textColor="@color/librewolf_text"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/onboarding_default_browser_sub"
                        android:textColor="@color/librewolf_grey"
                        android:textSize="13sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/onboarding_default_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/onboarding_dots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/onboarding_action"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/onboarding_action_bg"
        android:focusable="true"
        android:gravity="center"
        android:textColor="@color/librewolf_icon_on_accent"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
