<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/librewolf_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mode_tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_on"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/tabs"
            android:textColor="@color/librewolf_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mode_private"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_off"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/tab_private"
            android:textColor="@color/librewolf_grey" />

        <TextView
            android:id="@+id/mode_inactive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_off"
            android:clickable="true"
            android:focusable="false"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/inactive"
            android:textColor="@color/librewolf_grey"
            android:visibility="gone" />

        <TextView
            android:id="@+id/mode_groups"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_off"
            android:clickable="true"
            android:focusable="false"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/groups"
            android:textColor="@color/librewolf_grey"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tray_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tab_count"
            android:gravity="center"
            android:minWidth="40dp"
            android:minHeight="40dp"
            android:text="5"
            android:textColor="@color/librewolf_text"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/tray_close_all"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close_all_tabs"
            android:src="@drawable/ic_trash" />
    </LinearLayout>

    <TextView
        android:id="@+id/tray_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="32dp"
        android:textAlignment="center"
        android:textColor="@color/librewolf_grey"
        android:textSize="15sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tabs_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="420dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_search" 
            android:importantForAccessibility="no"/>

            <ImageView
                android:layout_width="4dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:background="#3A3A40" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⋮⋮⋮"
                android:textColor="@color/librewolf_grey"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_shield" 
            android:importantForAccessibility="no"/>

            <TextView
                android:id="@+id/tray_trackers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/librewolf_text"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/sheet_new_tab"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_fab"
            android:contentDescription="@string/new_tab"
            android:src="@drawable/ic_add" />
    </LinearLayout>
</LinearLayout>
