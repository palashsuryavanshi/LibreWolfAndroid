<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android-12 cloud backup. Excluded in full, for the same reasons and with
  the same caveat as data_extraction_rules.xml: the Keystore key that seals the
  password vault is never backed up, so a restored copy of it could not be read.
-->
<full-backup-content>
    <exclude
        domain="root"
        path="." />
    <exclude
        domain="database"
        path="." />
    <exclude
        domain="sharedpref"
        path="." />
    <exclude
        domain="external"
        path="." />
    <exclude
        domain="file"
        path="." />
    <!-- No `cache` domain here: this older schema does not have one. The
         cache is excluded by the platform regardless, and data_extraction_rules
         covers it for the Android 12+ path. -->
</full-backup-content>