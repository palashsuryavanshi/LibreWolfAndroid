<?xml version="1.0" encoding="utf-8"?>
<!-- A filled pill, tinted by the theme so the same drawable serves light and dark. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/librewolf_grey" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/librewolf_accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
