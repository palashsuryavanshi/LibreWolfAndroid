<?xml version="1.0" encoding="utf-8"?>
<!-- Round adaptive launcher icon, referenced by android:roundIcon. Same layers
     as ic_launcher: the artwork is already circular and carries no baked mask,
     so both resolve identically and the launcher shape decides. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
